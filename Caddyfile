# Static file server for the built site (see Dockerfile).
# Small, fast and cheap to run: no Node process at runtime.
{
	admin off
	auto_https off
	persist_config off
}

# Railway provides the port in $PORT
:{$PORT:8080} {
	root * /srv

	# compress text responses (JS, CSS, HTML, SVG, JSON)
	encode zstd gzip

	# hashed build files never change -> cache for a year
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# media in /public keeps its name -> cache for 30 days
	@media path /hero/* /about/* /brand/* /favicon.svg
	header @media Cache-Control "public, max-age=2592000"

	# the page itself must always be fresh so new deploys show up
	@html path / /index.html
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# single-page app: unknown paths fall back to index.html
	try_files {path} /index.html
	file_server
}
